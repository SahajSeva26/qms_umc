# =============================================================================
# QMS Backend — Environment Variables
# =============================================================================
# Copy this file to `.env` and fill in real values. `.env` is gitignored —
# never commit real secrets.
#
# Every variable the app reads is listed here (source: src/shared/config/app.config.ts).
# Fallbacks shown in comments are the DEV defaults baked into the code; they are
# UNSAFE for production and MUST be overridden on the server.
# =============================================================================


# -----------------------------------------------------------------------------
# App / Runtime
# -----------------------------------------------------------------------------
# Environment switch — drives secure cookies, rate limits, log level & format.
# Use "production" on the server. (default: development)
APP_ENV=development

# Port the HTTP server listens on. PORT wins over APP_PORT. (default: 3000)
PORT=3000
# APP_PORT=3000

# Host label used in logs/health-check. (default: localhost)
APP_HOST=localhost

# Allowed frontend origins for CORS — comma-separated, no trailing slash.
# e.g. https://app.qms.example.com,https://admin.qms.example.com
# (dev fallback: http://localhost:5173,http://localhost:3000 — prod fallback: http://localhost:5174)
APP_CORS_ORIGINS=http://localhost:5173,http://localhost:3000


# -----------------------------------------------------------------------------
# Database  (REQUIRED)
# -----------------------------------------------------------------------------
# MongoDB connection string. MUST be a REPLICA SET — the app uses transactions,
# which fail on a standalone mongod. (Atlas is a replica set out of the box.)
# (default: mongodb://localhost:27017/qms)
DB_URI=mongodb://localhost:27017/qms


# -----------------------------------------------------------------------------
# JWT / Auth  (REQUIRED — SECURITY CRITICAL)
# -----------------------------------------------------------------------------
# Use long, random, unique values in production. The code falls back to
# 'secret' / 'refresh-secret' — forgeable, never ship those.
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# Token lifetimes in seconds. (defaults: access 900 = 15 min, refresh 604800 = 7 days)
JWT_ACCESS_EXPIRY_SEC=900
JWT_REFRESH_EXPIRY_SEC=604800


# -----------------------------------------------------------------------------
# Seeded System User  (set strong values in production)
# -----------------------------------------------------------------------------
# Seeded on boot if missing. Don't ship the Test@123 default. (defaults shown)
APP_SYSTEM_USER_EMAIL=system@gmail.com
APP_SYSTEM_USER_PASSWORD=change-me
APP_SYSTEM_USER_PHONE=7456920792


# -----------------------------------------------------------------------------
# Seeded Admin User  (set strong values in production)
# -----------------------------------------------------------------------------
APP_ADMIN_USER_EMAIL=admin@gmail.com
APP_ADMIN_USER_PASSWORD=change-me
APP_ADMIN_USER_PHONE=7456920792


# -----------------------------------------------------------------------------
# System Tenant  (defaults are usually fine)
# -----------------------------------------------------------------------------
APP_SYSTEM_TENANT_CODE=qms
APP_SYSTEM_TENANT_NAME=QMS
APP_SYSTEM_TENANT_DESCRIPTION=QMS internal tenant for system operations


# -----------------------------------------------------------------------------
# AWS — shared credentials (used by S3, EventBridge, SQS)
# -----------------------------------------------------------------------------
# Region has a fallback (ap-south-1); the key + secret do NOT — required for any
# AWS feature (file upload, notifications).
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AWS S3 — file storage. Bucket required for uploads.
# Endpoint only for LocalStack / S3-compatible dev (leave empty for real AWS).
AWS_S3_BUCKET=
AWS_S3_ENDPOINT=

# AWS EventBridge — domain event publishing.
# NOTE: .env typically sets Source to "qms" (the EventBridge rule must match it).
# (defaults: bus "default", source "qms.backend")
AWS_EVENT_BRIDGE_BUS_NAME=default
AWS_EVENT_BRIDGE_SOURCE=qms

# AWS SQS — queue the notification worker consumes. Required for the worker.
AWS_SQS_NOTIFICATION_QUEUE_URL=


# -----------------------------------------------------------------------------
# Google Maps — geocoding / places  (required for geo features)
# -----------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=


# -----------------------------------------------------------------------------
# Jira — bug reporting integration  (optional)
# -----------------------------------------------------------------------------
# Email + token have no fallback; leave empty to disable. (non-secret defaults shown)
JIRA_BASE_URL=https://sahajseva.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=QF
JIRA_ISSUE_TYPE=Bug


# -----------------------------------------------------------------------------
# Rate Limiting  (optional — sensible defaults in code)
# -----------------------------------------------------------------------------
# Global limiter (defaults: 60000ms window / 100 req per IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Auth endpoints — stricter (defaults: 60000ms / 10)
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10

# Report endpoints — heavy queries (defaults: 60000ms / 50)
REPORT_RATE_LIMIT_WINDOW_MS=60000
REPORT_RATE_LIMIT_MAX=50


# -----------------------------------------------------------------------------
# Deployment metadata  (optional — auto-injected by Railway)
# -----------------------------------------------------------------------------
# Only needed if NOT deploying on Railway and you want /health-check to report
# the live commit. Railway sets the RAILWAY_GIT_* vars automatically.
# GIT_COMMIT_SHA=


# -----------------------------------------------------------------------------
# Dev seed scripts  (optional — only for src/shared/env/script/*)
# -----------------------------------------------------------------------------
# Base URL used by the demo seeding script. Not needed at runtime.
# SEED_BASE_URL=http://localhost:3000
