// =============================================================================
// QMS Healthcare Operations Platform - MongoDB / Mongoose schema
// Reverse-engineered ONLY from src/modules/**/*.model.ts. Nothing invented.
//
// READING NOTES
// -----------------------------------------------------------------------------
// * MongoDB has no foreign keys. Every "Ref" below is a Mongoose `ref` / `refPath`
//   declaration on an ObjectId field, i.e. an application-level reference.
// * `_id` is Mongo's implicit primary key on every collection and every embedded
//   subdocument (unless the subschema sets `_id: false`).
// * Tables named `*_<sub>` are EMBEDDED ARRAYS, not real collections. They live
//   inside their parent document. Their `_parent` column is SYNTHETIC - it only
//   exists to draw the containment line on the diagram.
// * Small embedded value-objects with no ObjectId refs (avatar, timeSlot, agenda,
//   mom, goLiveScope, dietChart, campTimeSlots, offers) are flattened into their
//   parent table using dotted column names, to keep the diagram readable.
// * Polymorphic refs (Mongoose `refPath`) produce SEVERAL ref lines from one
//   column. They are grouped at the bottom under POLYMORPHIC REFERENCES.
// * Collection names shown are the Mongoose-pluralised names; the model name used
//   in `ref:` declarations is given in each table note.
// =============================================================================


// =============================================================================
// ENUMS
// =============================================================================

Enum tenant_type {
  platform
  customer
}

Enum active_inactive {
  active
  inactive
}

Enum user_status {
  active
  inactive
  suspended
  deleted
}

Enum user_gender {
  male
  female
  other
}

Enum contact_type {
  customer
  platform
}

Enum lead_status {
  new
  qualified
  proposal
  pilot
  negotiation
  won
  lost
}

Enum lead_project_type {
  screening
  diet
  tele_diet
  lab
  mixed
}

Enum project_status {
  new
  live
  hold
  closed
}

Enum project_exec_mode {
  po
  agreement
  mail_confirmation
}

Enum payment_terms {
  net_30
  net_60
  net_90
}

Enum go_live_scope {
  states
  cities
  pan
}

Enum report_cadence {
  weekly
  half_monthly
  monthly
  quarterly
  halfyearly
  yearly
}

Enum appointment_type {
  new
  "follow-up"
  payment
  spot
}

Enum appointment_mode {
  online
  offline
  call
}

Enum appointment_status {
  planned
  done
  cancelled
  released
}

Enum appointment_invite_status {
  pending
  accepted
  declined
}

Enum camp_type {
  screening
  diet
  lab
}

Enum camp_billing_type {
  billable
  void
}

Enum camp_status {
  requested
  confirmed
  live
  closed
  cancelled
  cancelled_charged
}

Enum geo_profile_type {
  fo
  dietitian
}

Enum doctor_specialization {
  cp
  gp
}

Enum counter_entity {
  lead
  project
  invoice
  camp
  appointment
}

Enum qa_feedback_status {
  open
  resolved
}

Enum inventory_item_type {
  device
  consumable
}

Enum inventory_device_status {
  available
  "in-transit"
  assigned
  maintainance
  lost
  damaged
}

Enum inventory_consumable_status {
  active
  expired
}

Enum inventory_request_type {
  refill
  return
}

Enum inventory_request_status {
  requested
  approved
  rejected
  received
  cancelled
}

Enum inventory_stock_kind {
  InventoryMaster [note: 'catalog item - only valid on a REFILL request line']
  InventoryDevice [note: 'a concrete serialised unit']
  InventoryConsumable [note: 'a concrete stock lot']
}

Enum inventory_location {
  warehouse
  "in-transit"
  "field-officer"
}


// =============================================================================
// GROUP 1 - IDENTITY, TENANCY & RBAC  (user + access-management)
// =============================================================================

Table users {
  _id ObjectId [pk]
  firstName String [not null, note: 'trimmed + lowercased, max 50']
  lastName String
  email String [not null, unique, note: 'globally unique login identity, lowercased']
  phone String
  password String [not null, note: 'bcrypt hash, min 6 raw']
  "avatar.url" String [note: 'embedded object, defaults to a stock image URL']
  "avatar.id" String
  status user_status [default: 'active']
  gender user_gender
  refreshToken String [note: 'current refresh JWT, null when logged out - single-session by design']
  loginAttempts Number [default: 0, note: 'account lockout counter']
  lockUntil Date [note: 'lockout expiry']
  meta Mixed
  createdAt Date
  updatedAt Date

  Note: '''
  Mongoose model: User. THE LOGIN IDENTITY ONLY.
  A User carries NO tenant, NO role and NO permissions - it is deliberately
  authorization-free. The link runs the other way: Role.user -> User.
  So one User may own MANY Role documents (one per tenant / per posting), and the
  access token pins which single role the session is currently acting as.
  '''
}

Table tenants {
  _id ObjectId [pk]
  code String [not null, unique]
  name String [not null]
  description String
  type tenant_type [default: 'customer', note: 'platform = QMS itself; customer = a pharma client']
  owner ObjectId [ref: > roles._id, note: 'the tenant-admin Role, minted during createTenant. Null until set']
  salesPerson ObjectId [ref: > roles._id, note: 'optional PLATFORM sales-rep Role owning this account. Becomes the default Lead.salesPerson']
  status active_inactive [default: 'active']
  createdAt Date
  updatedAt Date

  Note: '''
  Mongoose model: Tenant. THE ROOT ISOLATION KEY of the whole platform.
  Circular by design: Tenant.owner -> Role, and Role.tenant -> Tenant.
  A tenant is frozen if status != active (checked in AuthMiddleware on every request).
  '''
}

Table role_types {
  _id ObjectId [pk]
  code String [not null, note: 'system, admin, sales-rep, sales-head, camp-coordinator-*, operation-manager-*, inventory-manager, field-officer, pharma-division-head, pharma-rsm, pharma-asm, pharma-mr']
  name String [not null]
  description String
  permissions String[] [note: 'ARRAY OF PERMISSION CODE STRINGS (e.g. camp:manage). NOT ObjectIds - there is no join table']
  status active_inactive [default: 'active']
  isSystem Boolean [default: false, note: 'seed-owned. Set only by the seeder, never by the API; reserves the code']
  tenant ObjectId [not null, ref: > tenants._id]
  createdAt Date
  updatedAt Date

  indexes {
    (tenant, code) [unique, name: 'tenant_code_unique']
  }

  Note: '''
  Mongoose model: RoleType. The permission TEMPLATE - "what a job title can do".
  Cloned per tenant by the seeder/provisioner, hence code is unique per tenant,
  not globally.
  '''
}

Table roles {
  _id ObjectId [pk]
  code String [not null]
  name String [not null]
  description String
  permissions String[] [note: 'PER-ROLE OVERRIDE codes, unioned on top of RoleType.permissions. Code comment: only temp or wildcard permissions']
  status active_inactive [default: 'active']
  type ObjectId [not null, ref: > role_types._id]
  user ObjectId [not null, ref: > users._id]
  tenant ObjectId [not null, ref: > tenants._id]
  division ObjectId [ref: > divisions._id, note: 'optional. Only customer field-force roles (MR/ASM/RSM/division-head) belong to a division. Null = not division-restricted']
  supervisor ObjectId [ref: > roles._id, note: 'SELF-REFERENCE. Reporting line MR -> ASM -> RSM. Must share the tenant; cycles rejected in the service']

  indexes {
    (tenant, code) [unique, name: 'tenant_code_unique']
  }

  Note: '''
  Mongoose model: Role. THE TRUE ACTOR of this system - almost every other
  collection points at a Role, not at a User.
  It is the junction of User x Tenant x RoleType (+ optional Division).
  NOTE: this is the ONE schema without { timestamps: true } - no createdAt/updatedAt.
  Effective permissions = RoleType.permissions UNION Role.permissions, then filtered
  against the code registry (shared/env/permissions.ts) inside AuthMiddleware.
  '''
}

Table permission_groups {
  _id ObjectId [pk]
  code String [not null, unique]
  name String [not null]
  description String [not null]
  status active_inactive [default: 'active', note: 'if inactive the whole tenant is frozen - AuthMiddleware rejects every request']
  tenant ObjectId [not null, ref: > tenants._id, note: 'looked up by tenant in AuthMiddleware - one PG per tenant by convention']
  createdAt Date
  updatedAt Date

  Note: '''
  Mongoose model: PermissionGroup. The CATALOGUE of permission codes a tenant is
  allowed to hand out - its permission boundary / licence.
  IMPORTANT: nothing references PermissionGroup by ObjectId. Roles and RoleTypes do
  NOT link to it; they only store raw permission code strings. It is joined to a
  request indirectly, via { tenant: role.tenant }. Its only structural edge is
  PermissionGroup.tenant -> Tenant.
  '''
}

Table permission_group_permissions {
  _id ObjectId [pk]
  _parent ObjectId [ref: > permission_groups._id, note: 'SYNTHETIC - containment only']
  code String [note: 'the permission code string, e.g. camp:manage']
  name String
  description String

  Note: 'EMBEDDED ARRAY in permission_groups.permissions'
}


// =============================================================================
// GROUP 2 - CRM  (division, contact, lead, project, appointment)
// =============================================================================

Table divisions {
  _id ObjectId [pk]
  tenant ObjectId [not null, ref: > tenants._id]
  code String [not null]
  name String [not null]
  therapy String[] [not null, note: 'LIST of therapy areas (cardiology, diabetes, ...). Min 1 element enforced by validator']
  brandFocus String
  mrCount Number [default: 0, note: 'plain stored counter - NOT a computed join on roles']
  status active_inactive [default: 'active']
  owner ObjectId [ref: > roles._id, note: 'the division-head Role. Mirrors Tenant.owner; unset until onboarding completes']
  createdAt Date
  updatedAt Date

  indexes {
    (tenant, code) [unique, name: 'tenant_code_unique']
  }

  Note: 'Mongoose model: Division. A pharma client sub-org. One level finer than Tenant, and the second scoping key after tenant.'
}

Table contacts {
  _id ObjectId [pk]
  tenant ObjectId [not null, ref: > tenants._id]
  division ObjectId [ref: > divisions._id, note: 'required for customer-type contacts, unset for platform/tenant-level ones (enforced in the service, not the schema)']
  name String [not null]
  designation String
  email String
  phone String
  location String
  type contact_type [default: 'customer', note: 'immutable after create']
  user ObjectId [ref: > users._id, note: 'OPTIONAL LOGIN LINK - null for the many contacts who never sign in. Set the day they get an account']
  status active_inactive [default: 'active']
  createdAt Date
  updatedAt Date

  indexes {
    (tenant, email) [unique, name: 'tenant_email_unique_partial', note: 'partial index, only where email is a string, so the many email-less contacts do not collide on null']
  }

  Note: '''
  Mongoose model: Contact. A PERSON RECORD that exists independently of login.
  Contact -> User is the soft 0..1 bridge between the CRM address book and the
  identity system. It is NOT how authorization works (that is Role).
  '''
}

Table leads {
  _id ObjectId [pk]
  code String [not null, unique, note: 'human code from the lead counter']
  tenant ObjectId [not null, ref: > tenants._id]
  division ObjectId [not null, ref: > divisions._id]
  contactPerson ObjectId [not null, ref: > contacts._id]
  focusTherapy String[]
  focusTherapyDoctor String[]
  title String [not null]
  problemStatement String [not null]
  numberOfMRS Number [not null]
  currentlyDoing String[]
  notes String
  projectType lead_project_type [not null, default: 'screening']
  offers Object[] [note: 'EMBEDDED, flattened: [{ code, subOffer, reason }] - plain strings, no refs']
  estimatedValue Number [not null, default: 0]
  followUpDate Date
  confidence Number [not null, note: '0-100']
  salesPerson ObjectId [not null, ref: > roles._id, note: 'defaults to Tenant.salesPerson on create; overriding to another Role requires lead:manage']
  status lead_status [default: 'new']
  meta Object
  createdAt Date
  updatedAt Date

  Note: 'Mongoose model: Lead. The CRM pipeline entry. A won Lead becomes a Project (Project.lead is required).'
}

Table lead_stage_history {
  _id ObjectId [pk]
  _parent ObjectId [ref: > leads._id, note: 'SYNTHETIC - containment only']
  from lead_status [not null]
  to lead_status [not null]
  "actor.roleId" ObjectId [ref: > roles._id, note: 'REAL ref inside the embedded doc']
  "actor.name" String [note: 'FROZEN SNAPSHOT - deliberately duplicated so history stays true if the role/user is later renamed']
  "actor.email" String [note: 'frozen snapshot']
  reason String [not null]
  createdAt Date
  updatedAt Date

  Note: 'EMBEDDED ARRAY in leads.stageHistory - append-only audit trail'
}

Table projects {
  _id ObjectId [pk]
  name String [not null]
  code String [not null, unique, note: 'from the project counter']
  tenant ObjectId [not null, ref: > tenants._id]
  division ObjectId [not null, ref: > divisions._id]
  lead ObjectId [not null, ref: > leads._id, note: 'REQUIRED - every project originates from exactly one lead']
  therapy String [not null, note: 'SINGLE enum value - unlike Division.therapy which is a list']
  type String[] [not null, note: 'screening_camp | diet | teleconsultation_diet | lab_test | mixed']
  tests String[] [note: 'fbs, ppbs, rbs, bp, spo2, ecg, lipid, spiro, bca']
  campCost Number [default: 0]
  totalCamps Number [default: 0]
  gst Number [note: '0-100']
  valueBeforeGST Number [default: 0]
  additionalCost Number [default: 0]
  campTimeSlots Object[] [note: 'EMBEDDED, flattened: [{ start, end }] time strings']
  freeCancelHours Number [default: 0]
  cancellationAllowed Number [default: 0, note: 'percent']
  campCostDeductionOnChargableCancel Number [note: 'percent']
  "goLiveScope.code" go_live_scope
  "goLiveScope.values" String[] [note: 'state or city names, lowercased. Plain strings - there is no geography collection']
  whoCanBookCamp String[] [note: 'CUSTOMER role-type CODES (pharma-mr, pharma-asm, ...) as strings - NOT ObjectId refs to role_types']
  salesRep ObjectId [not null, ref: > roles._id]
  projectCoordinator ObjectId [not null, ref: > roles._id]
  marketingContact ObjectId [not null, ref: > contacts._id]
  paymentTerms payment_terms [not null]
  status project_status [default: 'new']
  daysToBookBefore Number [default: 0]
  effectiveEarliestSlot Date
  dietChart Object[] [note: 'EMBEDDED, flattened: [{ name, url }]']
  poRenewalReminder Number [default: 0, note: 'percent of camps completed that triggers the renewal reminder']
  clientReportCandance report_cadence
  availablePointers String[]
  tats String
  sops String
  createdAt Date
  updatedAt Date

  Note: 'Mongoose model: Project. The commercial container a Camp is booked against. Carries the whole booking/cancellation rulebook.'
}

Table project_execution_mode {
  _parent ObjectId [ref: - projects._id, note: 'SYNTHETIC - containment only. SINGLE embedded subdoc (_id: false), hence ONE-TO-ONE']
  mode project_exec_mode [not null]
  poNumber String [note: 'mode = po']
  poDate Date
  poExpiry Date
  agreementNumber String [note: 'mode = agreement']
  agreementStartDate Date
  agreementEndDate Date
  duration Number
  agreementDocument String [note: 'file path/URL string - there is no document collection yet']
  emailReference String [note: 'mode = mail_confirmation']
  emailDocument String

  Note: 'EMBEDDED SINGLE SUBDOC in projects.executionMode. Only the block matching `mode` is populated; the others stay null.'
}

Table project_stage_history {
  _id ObjectId [pk]
  _parent ObjectId [ref: > projects._id, note: 'SYNTHETIC - containment only']
  from project_status [not null]
  to project_status [not null]
  "actor.roleId" ObjectId [ref: > roles._id]
  "actor.name" String [note: 'frozen snapshot']
  "actor.email" String [note: 'frozen snapshot']
  reason String [not null]
  createdAt Date
  updatedAt Date

  Note: 'EMBEDDED ARRAY in projects.stageHistory'
}

Table appointments {
  _id ObjectId [pk]
  code String [not null, note: 'from the appointment counter']
  tenant ObjectId [not null, ref: > tenants._id]
  division ObjectId [not null, ref: > divisions._id]
  type appointment_type [not null]
  salesPerson ObjectId [not null, ref: > roles._id, note: 'the owner - auto-set to the creating Role']
  contactPerson ObjectId [not null, ref: > contacts._id, note: 'the client-side attendee']
  lead ObjectId [ref: > leads._id, note: 'optional - set for follow-up appointments']
  parent ObjectId [ref: > appointments._id, note: 'SELF-REFERENCE - links a follow-up appointment back to the one it came from']
  mode appointment_mode [not null, default: 'online']
  destinationLink String [note: 'meet link OR map link, depending on mode']
  "duration.startTime" Date [not null]
  "duration.endTime" Date
  "agenda.public" String
  "agenda.private" String
  status appointment_status [default: 'planned', note: 'planned -> done/cancelled (terminal); released -> planned/cancelled. `released` is currently unreachable - its only feeder (blocked) was removed']
  "mom.details" String [note: 'minutes of meeting']
  "mom.submittedAt" Date
  "mom.submissionDeadline" Date
  createdAt Date
  updatedAt Date

  Note: 'Mongoose model: Appointment. A sales meeting. Bridges Role (internal side), Contact (client side) and optionally Lead.'
}

Table appointment_internal_members {
  _id ObjectId [pk]
  _parent ObjectId [ref: > appointments._id, note: 'SYNTHETIC - containment only']
  role ObjectId [not null, ref: > roles._id, note: 'REAL ref - the invited internal attendee']
  status appointment_invite_status [default: 'pending']
  note String
  createdAt Date
  updatedAt Date

  Note: '''
  EMBEDDED ARRAY in appointments.internalMembers.
  This is the MANY-TO-MANY join between Appointment and Role (invitees), stored
  inline rather than as its own collection.
  '''
}

Table appointment_stage_history {
  _id ObjectId [pk]
  _parent ObjectId [ref: > appointments._id, note: 'SYNTHETIC - containment only']
  from appointment_status [not null]
  to appointment_status [not null]
  "actor.roleId" ObjectId [ref: > roles._id]
  "actor.name" String [note: 'frozen snapshot']
  "actor.email" String [note: 'frozen snapshot']
  reason String [not null]
  nextSteps String [note: 'next step captured PER TRANSITION - replaced the old single mutable field']
  createdAt Date
  updatedAt Date

  Note: 'EMBEDDED ARRAY in appointments.stageHistory'
}


// =============================================================================
// GROUP 3 - OPERATIONS  (camp, geoProfile) + the global doctor registry
// =============================================================================

Table doctors {
  _id ObjectId [pk]
  pharmaCode String [not null, unique]
  name String [not null]
  specialization doctor_specialization [not null]
  mobile String [not null]
  city String [not null]
  state String [not null]
  pincode String [not null]
  email String [not null, unique]
  googleMapLink String
  status active_inactive [default: 'active']
  createdAt Date
  updatedAt Date

  Note: '''
  Mongoose model: Doctor. GLOBAL registry - deliberately NOT tenant-scoped and has
  no tenant field. Shared across every client. Its only inbound edge is Camp.doctor.
  '''
}

Table camps {
  _id ObjectId [pk]
  code String [not null, unique, note: 'from the camp counter']
  doctor ObjectId [not null, ref: > doctors._id, note: 'the clinic/venue host']
  tenant ObjectId [not null, ref: > tenants._id]
  division ObjectId [not null, ref: > divisions._id]
  project ObjectId [ref: > projects._id, note: 'OPTIONAL - a VOID camp (billingType = void) is executed without a PO/project and reconciled later']
  mr ObjectId [ref: > roles._id, note: 'the booking MR Role']
  asm ObjectId [ref: > roles._id, note: 'denormalised upline, resolved from the MR supervisor chain']
  rsm ObjectId [ref: > roles._id, note: 'denormalised upline']
  type camp_type [default: 'screening']
  billingType camp_billing_type [default: 'billable']
  patientExpectation Number [default: 0]
  date Date [not null]
  "timeSlot.start" String [not null]
  "timeSlot.end" String [not null]
  city String [not null]
  state String [not null]
  coordinates Number[] [note: '2dsphere index. [longitude, latitude] - the point the nearest-FO $geoNear search runs around']
  fo ObjectId [ref: > roles._id, note: 'field officer. NOT set at creation - filled by the allocate step, which in turn gates confirmation']
  devices String[] [note: 'PLAIN LABEL STRINGS (e.g. bp-monitor). NOT refs to inventory_devices - the inventory module is not wired to camps yet']
  notes String
  conscentPath String [note: 'consent file path string']
  status camp_status [default: 'requested']
  createdAt Date
  updatedAt Date

  Note: '''
  Mongoose model: Camp. The unit of execution and the busiest hub in the schema -
  it points at Doctor, Tenant, Division, Project and FOUR different Roles
  (mr, asm, rsm, fo).
  '''
}

Table camp_stage_history {
  _id ObjectId [pk]
  _parent ObjectId [ref: > camps._id, note: 'SYNTHETIC - containment only']
  from camp_status [not null]
  to camp_status [not null]
  "actor.roleId" ObjectId [ref: > roles._id]
  "actor.name" String [note: 'frozen snapshot']
  "actor.email" String [note: 'frozen snapshot']
  reason String [not null]
  createdAt Date
  updatedAt Date

  Note: 'EMBEDDED ARRAY in camps.stageHistory'
}

Table geo_profiles {
  _id ObjectId [pk]
  tenant ObjectId [not null, ref: > tenants._id]
  role ObjectId [not null, unique, ref: - roles._id, note: 'UNIQUE => STRICT ONE-TO-ONE. A field-worker Role has at most one geo profile']
  type geo_profile_type [not null, note: 'fo | dietitian']
  status active_inactive [default: 'active']
  coordinates Number[] [note: '2dsphere index. [longitude, latitude] home base']
  coverageRadius Number [default: 35000, note: 'METERS (matches $geoNear units). 35000 = 35km default reach']
  meta Mixed
  createdAt Date
  updatedAt Date

  Note: '''
  Mongoose model: GeoProfile. The geo extension of a field-staff Role.
  Camp.coordinates + GeoProfile.coordinates/coverageRadius are what the nearest-FO
  allocation joins on - an INDIRECT, purely spatial relationship between Camp and
  GeoProfile, with no ObjectId link between the two.
  '''
}


// =============================================================================
// GROUP 4 - INVENTORY
// =============================================================================

Table inventory_masters {
  _id ObjectId [pk]
  code String [not null, unique, note: 'lowercased natural key']
  name String [not null]
  description String [not null]
  type inventory_item_type [not null, default: 'device']
  sku String [not null]
  unit String [not null]
  status active_inactive [default: 'active', note: 'inactive = soft delete']
  minStock Number [default: 0]
  maxStock Number [default: 0]
  createdAt Date
  updatedAt Date

  Note: '''
  Mongoose model: InventoryMaster. The GLOBAL CATALOGUE - what an item IS.
  No tenant field (global, like Doctor). Physical stock lives in inventory_devices
  and inventory_consumables.
  '''
}

Table inventory_devices {
  _id ObjectId [pk]
  item ObjectId [not null, ref: > inventory_masters._id, note: 'immutable after create']
  serialNumber String [not null, unique, note: 'immutable after create - the per-unit identity']
  manufacturingDate Date
  warrantyExpiryDate Date
  status inventory_device_status [not null, default: 'available']
  lastCalibrationDate Date
  nextCalibrationDate Date
  createdAt Date
  updatedAt Date

  Note: 'Mongoose model: InventoryDevice. ONE ROW PER PHYSICAL UNIT (serialised). One master -> many devices.'
}

Table inventory_consumables {
  _id ObjectId [pk]
  item ObjectId [not null, ref: > inventory_masters._id]
  batch String [not null]
  manufacturingDate Date [not null]
  expiryDate Date [not null, note: 'drives FEFO (first-expiry-first-out) picking']
  quantity Number [not null, default: 0]
  status inventory_consumable_status [not null, default: 'active']
  createdAt Date
  updatedAt Date

  indexes {
    (item, batch) [unique, name: 'item_batch_unique']
  }

  Note: 'Mongoose model: InventoryConsumable. ONE ROW PER STOCK LOT, identity = (item, batch). One master -> many lots.'
}

Table inventory_assignments {
  _id ObjectId [pk]
  assignee ObjectId [not null, ref: > roles._id, note: 'must be a field-officer RoleType. WHO HOLDS THE STOCK']
  inventoryType inventory_stock_kind [not null, note: 'DISCRIMINATOR for the polymorphic `inventory` column: InventoryDevice | InventoryConsumable']
  inventory ObjectId [not null, note: 'POLYMORPHIC (refPath: inventoryType) - see POLYMORPHIC REFERENCES below']
  quantity Number [not null, default: 1, note: 'forced to 1 for devices']
  createdAt Date
  updatedAt Date

  indexes {
    (assignee, inventoryType, inventory) [unique, name: 'assignee_inventory_unique']
  }

  Note: '''
  Mongoose model: InventoryAssignment. "WHO HOLDS WHAT" - the current-custody
  MANY-TO-MANY between Role (field officer) and stock, one row per pairing.
  It is a snapshot of state; the movement history lives in inventory_ledgers.
  '''
}

Table inventory_requests {
  _id ObjectId [pk]
  requestedBy ObjectId [not null, ref: > roles._id, note: 'always the field-officer Role. Non-manage actors only see their own']
  processedBy ObjectId [ref: > roles._id, note: 'the inventory-manager Role who approved/rejected. Known FIXME: an FO marking a refill received overwrites this']
  type inventory_request_type [not null, note: 'refill = warehouse -> FO; return = FO -> warehouse']
  status inventory_request_status [not null, default: 'requested', note: 'requested -> approved/rejected -> received (terminal), or cancelled']
  createdAt Date
  updatedAt Date

  Note: 'Mongoose model: InventoryRequest. The refill/return LIFECYCLE document. Its `received` transition is what writes rows into inventory_ledgers.'
}

Table inventory_request_line_items {
  _parent ObjectId [ref: > inventory_requests._id, note: 'SYNTHETIC - containment only']
  itemType inventory_stock_kind [not null, note: 'DISCRIMINATOR. A refill line may reference a MASTER ("send me a glucometer"); a return line always references a concrete device/lot']
  item ObjectId [not null, note: 'POLYMORPHIC (refPath: lineItems.itemType) - see POLYMORPHIC REFERENCES below']
  quantity Number [not null, default: 1]

  Note: 'EMBEDDED ARRAY in inventory_requests.lineItems (_id: false). At least one line is required.'
}

Table inventory_request_fulfillment {
  _parent_request ObjectId [ref: > inventory_requests._id, note: 'SYNTHETIC - this array is nested TWO levels deep: requests.lineItems[].fulfillment[]']
  itemType String [not null, note: 'InventoryDevice | InventoryConsumable only - never InventoryMaster']
  item ObjectId [not null, note: 'the reserved unit/lot. DELIBERATELY has NO ref/refPath in the schema - resolved by itemType in the service, since this is internal reservation bookkeeping never populated for the client']
  quantity Number [not null]

  Note: '''
  EMBEDDED ARRAY inside each line item (inventory_requests.lineItems[].fulfillment).
  Reservation bookkeeping: written at approve, read at receive, restored at cancel.
  Always empty for returns, whose lines are already concrete.
  '''
}

Table inventory_request_stage_history {
  _id ObjectId [pk]
  _parent ObjectId [ref: > inventory_requests._id, note: 'SYNTHETIC - containment only']
  from inventory_request_status [not null]
  to inventory_request_status [not null]
  "actor.roleId" ObjectId [ref: > roles._id]
  "actor.name" String [note: 'frozen snapshot']
  "actor.email" String [note: 'frozen snapshot']
  reason String [not null]

  Note: 'EMBEDDED ARRAY in inventory_requests.stageHistory (this subschema has NO timestamps)'
}

Table inventory_ledgers {
  _id ObjectId [pk]
  request ObjectId [not null, ref: > inventory_requests._id, note: 'the request whose stage transition caused this movement']
  requestType inventory_request_type [not null]
  inventoryType inventory_stock_kind [not null, note: 'DISCRIMINATOR: InventoryDevice | InventoryConsumable']
  inventory ObjectId [not null, note: 'POLYMORPHIC (refPath: inventoryType) - see POLYMORPHIC REFERENCES below']
  quantity Number [not null]
  from inventory_location [not null]
  to inventory_location [not null]
  assignee ObjectId [ref: > roles._id, note: 'the field officer on the FO side of the movement']
  "actor.roleId" ObjectId [ref: > roles._id, note: 'who performed the movement']
  "actor.name" String [note: 'frozen snapshot']
  "actor.email" String [note: 'frozen snapshot']
  createdAt Date
  updatedAt Date

  Note: '''
  Mongoose model: InventoryLedger. APPEND-ONLY stock movement journal, one row per
  device/lot moved. Written only by the system, inside the inventory-request
  transaction - never edited or deleted.
  inventory_assignments = current state; inventory_ledgers = how it got there.
  '''
}


// =============================================================================
// GROUP 5 - PLATFORM UTILITY
// =============================================================================

Table counters {
  _id ObjectId [pk]
  entity counter_entity [not null, unique, note: 'lead | project | invoice | camp | appointment']
  prefix String [not null]
  suffix String
  separator String [default: '-']
  padding Number [default: 6]
  format String [default: '{{prefix}}{{separator}}{{number}}']
  currentValue Number [default: 0]
  status active_inactive [default: 'active']
  description String
  createdAt Date
  updatedAt Date

  Note: '''
  Mongoose model: Counter. GLOBAL atomic sequence generator (findOneAndUpdate $inc).
  It has NO refs at all - it is joined only LOGICALLY: counters.entity names the
  target collection, and the generated string lands in Lead.code / Project.code /
  Camp.code / Appointment.code. Note it is global, not per-tenant.
  '''
}

Table qa_feedbacks {
  _id ObjectId [pk]
  pageRoute String [not null, note: 'a FRONTEND URL string (e.g. /crm) - deliberately not a ref; it describes a screen, not an entity']
  pageTitle String
  pinXPercent Number [not null, note: '0-100, viewport percentage not pixels']
  pinYPercent Number [not null, note: '0-100']
  comment String [not null]
  reportedBy ObjectId [not null, ref: > users._id, note: 'RARE: points at User, not Role']
  status qa_feedback_status [default: 'open']
  resolutionNote String
  createdAt Date
  updatedAt Date

  Note: 'Mongoose model: QaFeedback. Internal bug-pin tool. Almost standalone - User is its only edge.'
}


// =============================================================================
// POLYMORPHIC REFERENCES (Mongoose refPath)
// -----------------------------------------------------------------------------
// One ObjectId column whose target collection is chosen at runtime by a sibling
// discriminator column. dbdiagram draws several lines out of the same column -
// only ONE of them is live for any given row.
// =============================================================================

// inventory_assignments.inventory -> InventoryDevice OR InventoryConsumable
Ref: inventory_assignments.inventory > inventory_devices._id
Ref: inventory_assignments.inventory > inventory_consumables._id

// inventory_ledgers.inventory -> InventoryDevice OR InventoryConsumable
Ref: inventory_ledgers.inventory > inventory_devices._id
Ref: inventory_ledgers.inventory > inventory_consumables._id

// inventory_requests.lineItems[].item -> InventoryMaster (a refill ask) OR a
// concrete InventoryDevice / InventoryConsumable (a return, or a specific unit)
Ref: inventory_request_line_items.item > inventory_masters._id
Ref: inventory_request_line_items.item > inventory_devices._id
Ref: inventory_request_line_items.item > inventory_consumables._id


// =============================================================================
// TABLE GROUPS
// =============================================================================

TableGroup "1 - Identity, Tenancy & RBAC" {
  users
  tenants
  role_types
  roles
  permission_groups
  permission_group_permissions
}

TableGroup "2 - CRM" {
  divisions
  contacts
  leads
  lead_stage_history
  projects
  project_execution_mode
  project_stage_history
  appointments
  appointment_internal_members
  appointment_stage_history
}

TableGroup "3 - Operations" {
  doctors
  camps
  camp_stage_history
  geo_profiles
}

TableGroup "4 - Inventory" {
  inventory_masters
  inventory_devices
  inventory_consumables
  inventory_assignments
  inventory_requests
  inventory_request_line_items
  inventory_request_fulfillment
  inventory_request_stage_history
  inventory_ledgers
}

TableGroup "5 - Platform Utility" {
  counters
  qa_feedbacks
}
