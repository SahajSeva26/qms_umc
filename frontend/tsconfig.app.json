{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "module": "esnext",
    "types": [
      "vite/client"
    ],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,
    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    /* ===================== ADDED FOR SHADCN =====================
       `paths` without `baseUrl`. `baseUrl` is deprecated in TS 6 and was only
       here because the shadcn snippet predates TS 4.1, which made `paths`
       usable on its own. Without `baseUrl` a mapping must be RELATIVE — hence
       the leading "./" — and is resolved against this file's directory, so
       "./src/*" means "<frontend>/src/*", exactly what `baseUrl: "."` +
       "src/*" used to mean. Vite resolves the same alias independently in
       vite.config.ts.
       ============================================================ */
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src"
  ]
}