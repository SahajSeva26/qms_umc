VITE_API_URL="http://localhost:3000"
VITE_ENV=development

# LOCAL DEV ONLY — internal-frontend's dev-server origin, used to build a cross-origin href back
# to the shared login / internal app during local dev (two separate Vite servers, no proxy in
# front). Optional; defaults to http://localhost:5173 if unset. Production reaches the shared
# login through the SAME public origin via the deployment proxy (see
# md-files/FRONTEND_SPLIT_ARCHITECTURE.md §5a) — this var must NEVER be set in a production
# build; validate-env.mjs rejects the build if it is.
VITE_INTERNAL_DEV_ORIGIN="http://localhost:5173"

# Google Maps Platform — required for the shared LocationPicker component.
# Restrict the API key in Google Cloud Console to your actual origins (HTTP
# referrers) and to only the Maps JavaScript API, Places API (New), and
# Geocoding API.
VITE_GOOGLE_MAPS_API_KEY=
# Required specifically for AdvancedMarker (Cloud-based map styling).
# Create one in Google Cloud Console under Map Management > Map IDs.
VITE_GOOGLE_MAP_ID=
