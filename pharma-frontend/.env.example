VITE_API_URL="http://localhost:3000"
VITE_ENV=development

# Where the internal app's audience redirect sends an internal session that
# lands here by mistake, or where this app's own login/continue flow lives
# if it's hosted there (see the Decided login note in
# md-files/FRONTEND_SPLIT_ARCHITECTURE.md §5). Placeholder for local dev;
# must be a real configured value before any cross-host redirect is trusted.
VITE_INTERNAL_ORIGIN="http://localhost:5173"

# Google Maps Platform — required for the shared LocationPicker component.
# Restrict the API key in Google Cloud Console to your actual origins (HTTP
# referrers) and to only the Maps JavaScript API, Places API (New), and
# Geocoding API.
VITE_GOOGLE_MAPS_API_KEY=
# Required specifically for AdvancedMarker (Cloud-based map styling).
# Create one in Google Cloud Console under Map Management > Map IDs.
VITE_GOOGLE_MAP_ID=
